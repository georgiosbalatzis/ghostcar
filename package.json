{
  "name": "f1-phantom-cars",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "format": "prettier --write \"*.{js,json}\" \"e2e/**/*.js\" \"test/**/*.js\" \"src/main.jsx\" \"src/F1PhantomCars.jsx\" \"src/{app,components,features,hooks,styles}/**/*.{js,jsx,css}\" \"src/{domain,services,scene}/**/*.js\"",
    "format:check": "prettier --check \"*.{js,json}\" \"e2e/**/*.js\" \"test/**/*.js\" \"src/main.jsx\" \"src/F1PhantomCars.jsx\" \"src/{app,components,features,hooks,styles}/**/*.{js,jsx,css}\" \"src/{domain,services,scene}/**/*.js\"",
    "optimize:f1car": "node ./scripts/optimize-f1car.mjs",
    "prebuild": "npm run optimize:f1car",
    "build": "vite build",
    "test": "node --test",
    "test:unit": "node --test",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.162.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "meshoptimizer": "^0.25.0",
    "prettier": "^3.8.3",
    "vite": "^6.0.0"
  }
}
